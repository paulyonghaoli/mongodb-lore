# Copy to .env and fill in. Never commit .env.

# Atlas Sandbox. App user: read/write on the lore database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional read-only user for business data (sales). Falls back to MONGODB_URI when empty.
MONGODB_READONLY_URI=
MONGODB_DB=lore

ANTHROPIC_API_KEY=
# One model ID shared by everyone (contracts: Conventions)
LORE_MODEL=claude-opus-5-5

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
EMBEDDING_DIM=1024
# voyage | hash   (hash = offline, non-semantic fallback for local dev and tests)
EMBEDDING_PROVIDER=voyage

# atlas = $vectorSearch on the Sandbox | local = cosine in Python (local mongod, tests)
VECTOR_BACKEND=atlas

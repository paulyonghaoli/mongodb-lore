# Copy to .env and fill in. Never commit .env.

# Atlas Sandbox connection strings.
# App user: read/write on the Lore collections (sessions, memories, skills, audit_log...)
MONGODB_URI=mongodb+srv://lore_app:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Read-only user for business data (orders, stores, products). Falls back to MONGODB_URI if empty.
MONGODB_READONLY_URI=
MONGODB_DB=lore

ANTHROPIC_API_KEY=
LORE_MODEL=claude-opus-5-5

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
EMBEDDING_DIM=1024
# "voyage" or "hash" (offline fallback for local dev and tests; not semantic)
EMBEDDING_PROVIDER=voyage

# "atlas" uses $vectorSearch; "local" does cosine in Python (for a local mongod without Search)
VECTOR_BACKEND=atlas
